PORT=3000
SUPABASE_URL=https://boamknigehaygktkujkf.supabase.co
SUPABASE_PUBLISHABLE_KEY=COLOQUE_A_PUBLISHABLE_KEY
# Secret server-side key from Supabase Project Settings / API. Never frontend.
SUPABASE_SERVICE_ROLE_KEY=COLOQUE_A_SERVICE_ROLE_KEY
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=7rxcmdNRE9Ve7ocjAzG1S5LxyPxuSQ5fifhydpRJqt85
ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
# Optional: comma-separated allowed devnet SPL mints. Empty accepts any valid classic SPL mint.
ALLOWED_MINTS=
# Gemini: key only on server; choose an available model in your Google AI Studio project.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_AUTORUN=true
AGENT_POLL_MS=10000
# Alternative: AI_PROVIDER=openai + OPENAI_API_KEY and OPENAI_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional scheduled sync secret. Generate with: openssl rand -hex 32
JOB_TOKEN=

