{
  "name": "raftt-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/services.js"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "json-bigint": "1.0.0",
    "swagger-ui-dist": "5.33.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@electric-sql/pglite": "0.5.8"
  }
}
